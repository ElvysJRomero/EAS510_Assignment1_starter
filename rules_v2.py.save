        inp_kp, inp_desc = orb.detectAndCompute(inp, None)
        if src_desc is None or inp_desc is None:
            return out

        #NORM_HAMMING required for binary features -- crossCheck returns only consistent mutual pairs
        matcher = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
        matches = matcher.match(src_desc, inp_desc)

        #Valid m distance < 50
        valid = [match for match in matches if match.distance < 50]
